---
/**
 * Education cards: minimal graduation-cap outline with a gentle float
 * and a subtle tassel sway. Matches AnimatedWorkIcon styling; respects
 * prefers-reduced-motion.
 */
---

<div class='animated-education-icon flex h-12 w-12 items-center justify-center rounded-xl border border-border bg-muted/60'>
	<svg
		class='h-7 w-7 text-foreground/85'
		viewBox='0 0 24 24'
		fill='none'
		xmlns='http://www.w3.org/2000/svg'
		aria-hidden='true'
	>
		<!-- Mortarboard top -->
		<path
			class='cap-surface'
			d='M12 4L4 7.5L12 11L20 7.5L12 4Z'
			stroke='currentColor'
			stroke-width='1.6'
			stroke-linejoin='round'
		></path>
		<!-- Band under the cap -->
		<path
			d='M6 8.5v5.5c0 1.5 2.5 2.5 6 2.5s6-1 6-2.5V8.5'
			stroke='currentColor'
			stroke-width='1.6'
			stroke-linecap='round'
		></path>
		<!-- Tassel cord + drop (sway animation; origin set in CSS) -->
		<g class='tassel-group'>
			<path
				d='M17 9v3.5'
				stroke='currentColor'
				stroke-width='1.35'
				stroke-linecap='round'
			></path>
			<circle cx='17' cy='14' r='1.15' fill='currentColor' class='tassel-dot'></circle>
		</g>
	</svg>
</div>

<style>
	.animated-education-icon {
		animation: edu-icon-float 3.2s ease-in-out infinite;
	}

	@keyframes edu-icon-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
	}

	.cap-surface {
		animation: cap-shimmer 2.8s ease-in-out infinite;
	}

	@keyframes cap-shimmer {
		0%,
		100% {
			opacity: 0.88;
		}
		50% {
			opacity: 1;
		}
	}

	.tassel-group {
		transform-origin: 17px 9px;
		animation: tassel-sway 2.2s ease-in-out infinite;
	}

	@keyframes tassel-sway {
		0%,
		100% {
			transform: rotate(-6deg);
		}
		50% {
			transform: rotate(6deg);
		}
	}

	.tassel-dot {
		animation: tassel-pulse 1.6s ease-in-out infinite;
	}

	@keyframes tassel-pulse {
		0%,
		100% {
			opacity: 0.55;
		}
		50% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.animated-education-icon,
		.cap-surface,
		.tassel-group,
		.tassel-dot {
			animation: none;
		}
	}
</style>
