---
import type { CollectionEntry } from 'astro:content'

import Button from '@/components/Button.astro'

import PageLayout from './BaseLayout.astro'

interface Props {
	entry: CollectionEntry<'work'>
}

const { entry } = Astro.props
const { role, company, dateRange, description, summaryBullets } = entry.data
const metaDescription = description ?? summaryBullets[0]
---

<PageLayout meta={{ title: `${role} — ${company}`, description: metaDescription }}>
	<div class='w-full'>
		<Button title='Back' href='/work' style='button'>
			<svg
				xmlns='http://www.w3.org/2000/svg'
				width='14'
				height='14'
				viewBox='0 0 24 24'
				slot='icon-before'
			>
				<path
					fill='currentColor'
					d='m6.921 12.5l5.792 5.792L12 19l-7-7l7-7l.713.708L6.921 11.5H19v1z'
				>
				</path>
			</svg>
		</Button>

		<header class='mt-8 border-b border-border pb-8'>
			<p class='text-sm text-muted-foreground'>{dateRange}</p>
			<h1 class='mt-2 text-2xl font-bold text-foreground'>{role}</h1>
			<p class='mt-1 text-lg text-muted-foreground'>{company}</p>
		</header>

		<article
			class='prose prose-base prose-zinc mt-10 max-w-none break-words text-muted-foreground dark:prose-invert prose-headings:font-medium prose-headings:text-foreground prose-th:before:content-none'
		>
			<slot />
		</article>
	</div>
</PageLayout>
